# Aadukalam env template. Copy to .env.local and fill. Never commit real values.

# Solana RPC endpoints
NEXT_PUBLIC_SOLANA_RPC_MAINNET=https://api.mainnet-beta.solana.com
NEXT_PUBLIC_SOLANA_RPC_DEVNET=https://api.devnet.solana.com
NEXT_PUBLIC_SOLANA_CLUSTER=devnet

# Pyth Hermes (no key needed)
NEXT_PUBLIC_PYTH_HERMES=https://hermes.pyth.network

# Jupiter (free tier via lite-api needs no key; set if using paid api.jup.ag)
JUPITER_API_BASE=https://lite-api.jup.ag
JUPITER_API_KEY=

# Leash AI agent LLM (MiniMax, OpenAI-compatible, server-side only)
MINIMAX_API_BASE=https://api.minimax.io/v1
MINIMAX_API_KEY=
MINIMAX_MODEL=MiniMax-M3

# Anchor deployer (devnet keypair path, devnet SOL only)
ANCHOR_WALLET=./.devnet-keypair.json
